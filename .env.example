# Resend: envío de los formularios de /contacto y /agencias (app/actions/contact.ts).
# Rodrigo tiene que verificar el dominio oi0.es en Resend (DNS en Cloudflare) antes de
# que CONTACT_FROM pueda enviar como @oi0.es. Hasta entonces, usa el dominio de prueba
# de Resend o un remitente ya verificado.
RESEND_API_KEY=
CONTACT_TO=rodrigo@oi0.es
CONTACT_FROM=web@oi0.es
